{
  "info": {
    "name": "Enterprise API Troubleshooting & Observability Suite",
    "description": "Postman collection simulating production traffic, payload validation errors (400), authentication failures (401), not found (404), server exceptions (500), and gateway timeouts (504).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health Check (Expect 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "health"]
        }
      }
    },
    {
      "name": "2. Get Orders (Expect 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/api/v1/orders",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "orders"]
        }
      }
    },
    {
      "name": "3. Create Order - Valid (Expect 201 Created)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": \"CUST-8491\",\n  \"items\": [{\"sku\": \"AWS-CLF\", \"qty\": 1}]\n}"
        },
        "url": {
          "raw": "http://localhost:8080/api/v1/orders",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api", "v1", "orders"]
        }
      }
    },
    {
